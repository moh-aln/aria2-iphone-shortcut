#!/bin/sh
# dl: download links in the background, into a folder the Files app can see. Pages with a
# video in them (YouTube, Instagram, X, TikTok and many more) go to yt-dlp, files to aria2.
#
#   dl <link>...          download links (a link that's already in the list is resumed)
#   dl -b <base64 text>   same, with the text base64-encoded (what the Shortcut sends).
#                         Every http(s), ftp, sftp and magnet link in it is downloaded.
#   dl -s                 one line per download, with a progress bar
#   dl -m                 those lines plus the actions: the Shortcut's menu
#   dl -a -b <base64>     do what a chosen menu line says (a download line pauses or resumes it)
#   dl -p | -r | -c       pause all, resume all, clear finished from the list (files stay)
#   dl -u | -v            update aria2 and its tools now | show the tools' versions
#   dl <Bark link>        get a notification when a download ends, through the Bark app
#   dl --report [<id>]    a debug report, to send for help when a download goes wrong
#
# Finished downloads land in /root/Downloads, or in /mnt/phone when a Files folder is
# mounted there (see SHARE below).

DEST=${DL_DIR:-/root/Downloads}
JOBS=$DEST/.logs
# Finished downloads are moved into this folder when it's there: a Files folder mounted into
# iSH-AOK with `mount -t ios phone /mnt/phone` (such as On My iPhone → Downloads), for when
# Files can't open iSH-AOK's own location. Downloading itself always happens in $DEST.
SHARE=${DL_SHARE:-/mnt/phone}
# Where setup-on-phone.sh keeps the signed shortcut, and where updates come from.
SHORTCUTS=${DL_SHORTCUTS:-/root/Shortcuts}
SHORTCUT=  # the version of the Shortcut asking, when it says (dl -ui … -k <version>)
UPDATE_URL=${DL_UPDATE_URL:-https://raw.githubusercontent.com/moh-aln/aria2-iphone-shortcut/main/shortcuts/setup-on-phone.sh}
# Notifications go through the Bark app, because iSH-AOK can't post any itself: dl sends
# them to Bark's server, which pushes them to the phone. They're off until dl is given a
# link from Bark, which has the phone's key in it (see bark_link).
BARK=${DL_BARK:-https://api.day.app}
LINK_RE='(https?|s?ftp|magnet):[^[:space:]"<>]+'
SHOWN=10  # downloads in the list, newest first
# Links to these sites are pages with a video in them. Any other web link is checked
# when its download starts: a web page goes to yt-dlp too, anything else to aria2.
VIDEO_SITES='youtube.com youtu.be instagram.com x.com twitter.com tiktok.com facebook.com
  fb.watch reddit.com redd.it vimeo.com twitch.tv dailymotion.com soundcloud.com threads.net
  threads.com bsky.app pinterest.com pin.it bilibili.com streamable.com'

mkdir -p "$JOBS"

# A download is $JOBS/<id>.log and $JOBS/<id>.pid. The log's first line is the link. Each
# (re)start appends "=== start", "=== via <tool>", the tool's output, then "=== exit <code>",
# or "=== paused" when it's paused. The pid is the background worker running the tool.
ids() {
  for f in "$JOBS"/*.log; do
    id=${f##*/}
    id=${id%.log}
    case $id in '' | *[!0-9]*) continue ;; esac
    echo "$id"
  done | sort -rn
}

decode() { printf %s "$1" | tr -d ' \r\n' | base64 -d 2>/dev/null; }

host_of() {
  h=$(printf %s "$1" | sed -E 's|^[a-z]+://([^/:?#]*).*|\1|' | tr 'A-Z' 'a-z')
  printf %s "${h#www.}"
}

is_video_site() {
  h=$(host_of "$1")
  for site in $VIDEO_SITES; do
    case $h in "$site" | *."$site") return 0 ;; esac
  done
  return 1
}

# Is <pid> the worker of download <id>, and not a zombie?
alive() {
  # pstate, not state: load's callers read $state afterwards.
  [ -n "$1" ] && [ -r "/proc/$1/stat" ] && read -r _ _ pstate _ <"/proc/$1/stat" &&
    [ "$pstate" != Z ] && tr '\0' ' ' <"/proc/$1/cmdline" | grep -q -- "--work $2 *\$"
}

running() { alive "$(cat "$JOBS/$1.pid" 2>/dev/null)" "$1"; }

start() {  # start <link> <id>
  log=$JOBS/$2.log
  [ -f "$log" ] || printf '%s\n' "$1" >"$log"
  echo "=== start $(date)" >>"$log"
  # Output goes to the log, not the caller, so the Shortcut's Run Command returns at once.
  # setsid gives the download its own process group, so pausing stops all of it.
  $(command -v setsid) nohup sh "$0" --work "$2" >>"$log" 2>&1 </dev/null &
  echo $! >"$JOBS/$2.pid"
}

# iOS pauses iSH-AOK soon after it leaves the screen, unless iSH-AOK is getting location
# updates (with location access set to Always). So read /dev/location while anything is
# downloading, and stop once nothing is, to save battery.
keep_awake() {
  [ -e /dev/location ] || return 0
  pgrep -f 'dd if=/dev/location' >/dev/null && return 0
  nohup dd if=/dev/location of=/dev/null bs=64 >/dev/null 2>&1 </dev/null &
}

rest_unless_busy() {  # rest_unless_busy <id of the download that's ending>
  for id in $(ids); do
    [ "$id" != "$1" ] && running "$id" && return 0
  done
  pkill -f 'dd if=/dev/location' 2>/dev/null
}

fetch_file() {
  # --file-allocation=none: don't write zeros for the whole file up front (slow on a phone).
  # --max-tries/--retry-wait: ride out the connection drops iOS causes when it suspends the app.
  # --seed-time=0: stop a torrent as soon as it finishes instead of seeding.
  # --bt-stop-timeout: give up on a torrent that has had no data for 15 minutes.
  aria2c --dir="$DEST" --continue=true --file-allocation=none \
    --max-tries=20 --retry-wait=15 --seed-time=0 --bt-stop-timeout=900 \
    --follow-torrent=mem --enable-color=false \
    --show-console-readout=false --summary-interval=5 "$1"
}

# The JavaScript engine yt-dlp uses to work out YouTube's video links: Node when it's
# installed (about 4 times faster than QuickJS in iSH-AOK on an iPhone), else QuickJS.
js_runtime() {
  if command -v node >/dev/null; then
    echo '--js-runtimes node'
  elif command -v qjs >/dev/null; then
    echo '--js-runtimes quickjs'
  fi
}

# Quick downloads pick their quality by a rule, set in Settings (.logs/.quality).
# rule_format [<rule>] prints yt-dlp's -f for it, and then "audio" for sound only.
rule_format() {
  case ${1:-$(cat "$JOBS/.quality" 2>/dev/null)} in
    best) echo 'bv*+ba/b' ;;
    720 | 480)
      h=${1:-$(cat "$JOBS/.quality")}
      echo "bv*[vcodec^=avc1][height<=$h]+ba[ext=m4a]/b[ext=mp4][height<=$h]/bv*[height<=$h]+ba/b[height<=$h]/b" ;;
    audio) echo 'ba[ext=m4a]/ba/b'; echo audio ;;
    *) echo 'bv*[vcodec^=avc1]+ba[ext=m4a]/b[ext=mp4]/bv*+ba/b' ;;  # best for iPhone: H.264, up to 1080p on YouTube
  esac
}

rule_label() {  # rule_label [<rule>]
  case ${1:-$(cat "$JOBS/.quality" 2>/dev/null)} in
    best) echo "Best quality" ;;
    720) echo "720p" ;;
    480) echo "480p" ;;
    audio) echo "Audio only" ;;
    *) echo "Best for iPhone" ;;
  esac
}

rule_detail() {  # rule_detail [<rule>]
  case ${1:-$(cat "$JOBS/.quality" 2>/dev/null)} in
    best) echo "Up to 4K; some may not play in Files" ;;
    720) echo "H.264 at 720p: smaller files" ;;
    480) echo "H.264 at 480p: the smallest videos" ;;
    audio) echo "Just the sound, as M4A" ;;
    *) echo "H.264 up to 1080p: plays everywhere" ;;
  esac
}

fetch_video() {  # fetch_video <link> <id>
  # The quality: the one picked for this download (.fmt: -f, then "audio" for sound only),
  # else the quick download rule.
  fmt=$(sed -n 1p "$JOBS/$2.fmt" 2>/dev/null)
  sound=$(sed -n 2p "$JOBS/$2.fmt" 2>/dev/null)
  if [ -z "$fmt" ]; then
    fmt=$(rule_format | sed -n 1p)
    sound=$(rule_format | sed -n 2p)
  fi
  if [ "$sound" = audio ]; then
    as='-x --audio-format m4a'  # Opus and the like become AAC, which the iPhone plays
  else
    as='--merge-output-format mp4'
  fi
  # When the quality was picked from a list, yt-dlp has already found the video once:
  # downloading from what it found then saves doing it again (a minute on YouTube). Its
  # links last for hours, but an older one is found again.
  from=$1
  info=$JOBS/$2.info.json
  [ -n "$(find "$JOBS" -maxdepth 1 -name "$2.info.json" -mmin -60 2>/dev/null)" ] || info=
  # Progress is printed in the same shape as aria2's summaries, so the list reads both the
  # same way. The title and the final file come from --exec, not --print, which would hide
  # yt-dlp's other output: the step it's on is what the list shows until the download
  # starts.
  # A playlist link downloads the playlist into a folder named after it; a video link that
  # happens to come from a playlist (watch?v=…&list=…) downloads just that video.
  # Before each video, its picture is fetched in the background for the menus (see thumb).
  # -v puts yt-dlp's versions and every step it takes in the log, for the debug report
  # (see report); the list leaves its "[debug]" lines out.
  set -- -v --newline --no-playlist --no-mtime -P "$DEST" -o '%(playlist_title|.).80B/%(title).80B.%(ext)s' \
    -f "$fmt" $as $(js_runtime) \
    --exec 'before_dl:echo NAME: %(title)q' --exec 'after_move:echo FILE: %(filepath)q' \
    --exec "before_dl:sh '$0' --thumb $2 %(thumbnail)q >/dev/null 2>&1 &" \
    --progress-template 'download:[#yt %(progress._downloaded_bytes_str)s/%(progress._total_bytes_str)s(%(progress._percent_str)s) DL:%(progress._speed_str)s ETA:%(progress._eta_str)s]'
  if [ -n "$info" ]; then yt-dlp "$@" --load-info-json "$info"; else yt-dlp "$@" "$from"; fi
}

work() {  # work <id>: the background worker, for as long as the download takes
  link=$(head -n 1 "$JOBS/$1.log")
  keep_awake
  tool=aria2
  if is_video_site "$link"; then
    tool=yt-dlp
  else
    case $link in http*)
      type=$(curl -sL -m 20 -r 0-0 -o /dev/null -w '%{content_type}' "$link" 2>/dev/null)
      case $type in text/html* | application/xhtml*) tool=yt-dlp ;; esac ;;
    esac
  fi
  echo "=== via $tool"
  # Run the tool as a child, so that without setsid a pause still reaches it.
  child=
  trap 'kill $child 2>/dev/null' TERM
  if [ $tool = yt-dlp ]; then fetch_video "$link" "$1" & else fetch_file "$link" & fi
  child=$!
  wait $child
  code=$?
  # A playlist where some videos failed still hands over the ones that worked (yt-dlp only
  # says FILE: for finished files). A paused download stays put, so resuming finds its files.
  if [ $code = 0 ] || { [ $tool = yt-dlp ] && ! segment "$1" | grep -q '^=== paused'; }; then
    deliver "$1"
  fi
  echo "=== exit $code"
  announce "$1"
  # A failure leaves a debug report in Files, ready to send to whoever helps.
  load "$1"
  [ "$state" = failed ] && save_report "$1"
  update_if_due
  rest_unless_busy "$1"
}

# thumb <id> <picture link>: a small square of the video's picture, base64, for the menus.
thumb() { thumb_to "$JOBS/$1.thumb" "$2"; }

thumb_to() {  # thumb_to <file> <picture link>
  case $2 in http*) ;; *) return 0 ;; esac
  command -v ffmpeg >/dev/null || return 0
  # YouTube's best picture is large; the 320x180 one is plenty.
  url=$(printf %s "$2" | sed -E 's|^https?://i\.ytimg\.com/vi(_webp)?/([^/]+)/.*|https://i.ytimg.com/vi/\2/mqdefault.jpg|')
  tmp=$1.$$
  timeout 60 curl -fsSL -m 50 -o "$tmp.src" "$url" &&
    timeout 60 ffmpeg -nostdin -loglevel error -y -i "$tmp.src" -frames:v 1 -q:v 5 \
      -vf 'scale=96:96:force_original_aspect_ratio=increase,crop=96:96' "$tmp.jpg" &&
    base64 "$tmp.jpg" | tr -d '\n' >"$tmp" && mv -f "$tmp" "$1"
  rm -f "$tmp" "$tmp.src" "$tmp.jpg"
}

# ---- Choosing the quality: what "🎚 Choose the quality" finds out, in .logs/.choice/ ----
# link     what's being chosen for
# from     share (it came from the share sheet: a notification, then close) or menu
# rows     the qualities, from formats.py; done or failed once it's known which
# info     what yt-dlp found (-J), which the download then starts from
# video    the video picked, while the sound is being picked
CHOICE=$JOBS/.choice
FORMATS=${DL_FORMATS:-/usr/local/share/dl/formats.py}

choose() {  # choose <link> <share|menu>: start choosing the quality for a link
  probe_pid=$(cat "$CHOICE/pid" 2>/dev/null)
  [ -n "$probe_pid" ] && kill -TERM -"$probe_pid" 2>/dev/null
  rm -rf "$CHOICE"
  mkdir -p "$CHOICE"
  printf '%s\n' "$1" >"$CHOICE/link"
  echo "$2" >"$CHOICE/from"
}

probe_start() {  # find the qualities in the background; it can take a minute on YouTube
  [ -e "$CHOICE/pid" ] && return 0
  $(command -v setsid) nohup sh "$0" --probe >/dev/null 2>&1 </dev/null &
  echo $! >"$CHOICE/pid"
}

probe() {  # dl --probe: what probe_start runs
  keep_awake
  link=$(cat "$CHOICE/link")
  # --flat-playlist: a playlist is listed, not each of its videos found.
  if yt-dlp -v --no-playlist --flat-playlist $(js_runtime) -J "$link" >"$CHOICE/info.new" 2>"$CHOICE/log" &&
      python3 "$FORMATS" "$CHOICE/info.new" >"$CHOICE/rows.new" 2>>"$CHOICE/log" &&
      [ "$(cat "$CHOICE/link" 2>/dev/null)" = "$link" ]; then  # and not replaced meanwhile
    mv -f "$CHOICE/info.new" "$CHOICE/info"
    mv -f "$CHOICE/rows.new" "$CHOICE/rows"
    thumb_to "$CHOICE/thumb" "$(choice_field thumbnail)"
    : >"$CHOICE/done"
  elif [ -d "$CHOICE" ]; then
    : >"$CHOICE/failed"
  fi
  rest_unless_busy
}

probe_wait() {  # probe_wait <seconds>: until the qualities are known, or that long
  waited=0
  while [ ! -e "$CHOICE/done" ] && [ ! -e "$CHOICE/failed" ] && [ $waited -lt "$1" ]; do
    sleep 1
    waited=$((waited + 1))
  done
}

choice_field() {  # choice_field <title|thumbnail|playlist>: from the rows
  awk -F '\037' -v k="$1" '$1 == k { print $2; exit }' "$CHOICE/rows" 2>/dev/null
}

# chosen <format> [audio]: the quality is picked: start the download, and end the choice.
# Fails after an answer for the Shortcut (from the share sheet: a notification, then close).
chosen() {
  link=$(cat "$CHOICE/link")
  from=$(cat "$CHOICE/from")
  last=$(ids | head -n 1)
  new=$((${last:-0} + 1))
  # If the format picked is gone by the time it's resumed (hours later, say), the best for
  # iPhone will do.
  printf '%s/%s\n%s\n' "$1" "$(rule_format iphone)" "$2" >"$JOBS/$new.fmt"
  # What yt-dlp found goes with it, so it needn't look again; not for a playlist, though,
  # where it only listed the videos.
  if [ -e "$CHOICE/done" ] && [ -z "$(choice_field playlist)" ]; then
    mv -f "$CHOICE/info" "$JOBS/$new.info.json" 2>/dev/null
  fi
  mv -f "$CHOICE/thumb" "$JOBS/$new.thumb" 2>/dev/null
  title=$(choice_field title)
  start "$link" "$new"
  rm -rf "$CHOICE"
  finish "Started: ${title:-$(link_name "$link")}"
}

# finish <message>: a choice made: from the share sheet, a notification and close; from the
# menu, the list with the message on it. Fails after an answer for the Shortcut.
finish() {
  if [ "$from" = share ]; then
    echo "@@notify:$1"
    return 1
  fi
  notice "$1"
  screen=list
  return 0
}

segment() { # segment <id>: the log since the download's latest (re)start
  awk '/^=== start/ { buf = "" } { buf = buf $0 "\n" } END { printf "%s", buf }' "$JOBS/$1.log"
}

# Two kinds of update, each at most once a day after a download ends, and when the Shortcut
# opens (see auto_update), unless automatic updates are off in Settings:
#   tools: yt-dlp from its own releases (YouTube changes often, and Alpine's package lags
#          behind), the rest from Alpine
#   app:   dl itself, its pictures and the shortcut, from the project's repository
# Settings has a row for each that does it at once.
update_tools() {
  echo "=== update $(date)"
  # "=== step N <what>" lines are what Settings shows while this runs.
  echo "=== step 1 Alpine packages"
  timeout 600 apk update -q && timeout 1800 apk add -q -u aria2 curl ffmpeg nodejs quickjs
  echo "=== step 2 yt-dlp"
  case $(command -v yt-dlp) in /usr/local/bin/*) timeout 600 yt-dlp -U ;; esac
  yt-dlp --version >"$JOBS/.yt-dlp-version" 2>/dev/null
  date +%s >"$JOBS/.updated"
  echo "=== updated"
}

# The setup script installs dl, its pictures and, when it changed, a new signed shortcut.
# Run the repository's copy only when it differs from the one last run here.
update_app() {
  echo "=== check $(date)"
  date +%s >"$JOBS/.app-checked"
  if timeout 120 curl -fsSL -o "$JOBS/.setup.new" "$UPDATE_URL" &&
      [ "$(sha256sum <"$JOBS/.setup.new" | cut -d' ' -f1)" != "$(cat "$JOBS/.setup" 2>/dev/null)" ]; then
    echo "=== new version"
    # Only dl and the shortcut: the tools have their own update.
    DL_APP_ONLY=1 sh "$JOBS/.setup.new"
  fi
  rm -f "$JOBS/.setup.new"
  echo "=== checked"
}

update_now() {  # update_now tools | app
  lock=$JOBS/.updating log=$JOBS/.update.log
  [ "$1" = app ] && lock=$JOBS/.app-updating log=$JOBS/.app-update.log
  # One of each at a time; a lock older than an hour was left by an update iOS ended.
  find "$JOBS" -maxdepth 1 -name "${lock##*/}" -mmin +60 -exec rmdir {} \; 2>/dev/null
  mkdir "$lock" 2>/dev/null || return 0
  if [ "$1" = app ]; then update_app; else update_tools; fi >"$log" 2>&1
  rmdir "$lock"
}

update_in_background() {  # update_in_background tools | app | both
  $(command -v setsid) nohup sh "$0" --update "$1" >/dev/null 2>&1 </dev/null &
}

due() {  # due <file with a time> <seconds>: has that long passed since?
  last=$(cat "$1" 2>/dev/null)
  [ $(($(date +%s) - ${last:-0})) -ge "$2" ]
}

auto_updates() { [ ! -e "$JOBS/.no-auto-update" ]; }

update_if_due() {  # after a download
  auto_updates || return 0
  due "$JOBS/.updated" 86400 && update_now tools
  due "$JOBS/.app-checked" 86400 && update_now app
}

update_progress() {  # e.g. "Updating · 2 of 2: yt-dlp ▰▰▰▰▰▱▱▱▱▱"
  now=$(awk '/^=== update/ { s = "" } /^=== step / { s = $3 " " substr($0, index($0, $4)) } END { print s }' \
    "$JOBS/.update.log" 2>/dev/null)
  n=${now%% *}
  case $n in 1 | 2) ;; *) n=1 now="1 starting" ;; esac
  echo "Updating · $n of 2: ${now#* } $(bar $(((n - 1) * 50)))"
}

versions() {
  echo "yt-dlp $(yt-dlp --version 2>/dev/null) ($(command -v yt-dlp))"
  if command -v node >/dev/null; then echo "Node $(node --version) (used for YouTube)"; fi
  echo "$(aria2c --version 2>/dev/null | head -n 1)"
  # yt-dlp says QuickJS older than 2025-04-26 solves YouTube's challenges "very slowly".
  if command -v qjs >/dev/null; then qjs -h 2>&1 | head -n 1; else echo "QuickJS: not installed"; fi
  last=$(cat "$JOBS/.updated" 2>/dev/null)
  echo "Tools last updated: $( [ -n "$last" ] && date -d "@$last" 2>/dev/null || echo never)"
}

share_ready() {
  if [ -n "$DL_SHARE" ]; then
    [ -d "$SHARE" ]
  else
    awk -v dir="$SHARE" '$2 == dir { found = 1 } END { exit !found }' /proc/mounts 2>/dev/null
  fi
}

deliver() {  # deliver <id>: move the finished download into $SHARE, if that's mounted
  share_ready || return 0
  # yt-dlp says FILE: for each finished file. aria2 says it in its summaries, which a quick
  # download may not live to print, and in its "Download Results" row: gid|OK|speed|path.
  path=$(segment "$1" | sed -n 's/^FILE: //p' | tail -n 1)
  [ -n "$path" ] || path=$(segment "$1" | grep -E '^[0-9a-f]+\|OK' | tail -n 1 | cut -d'|' -f4-)
  case $path in "$DEST"/*) ;; *) return 0 ;; esac
  # A playlist's or a torrent's file is in a folder: move that whole folder.
  top=${path#"$DEST"/}
  top=${top%%/*}
  # The list shows this size afterwards, so it never has to look inside the Files folder:
  # reading there goes through iOS's file coordination, which can hold up the Files app.
  echo "=== size $(du -sh "$DEST/$top" 2>/dev/null | cut -f1)"
  echo "=== moving to Files"
  if [ -d "$DEST/$top" ]; then
    # Merge into a folder of the same name, file by file, leaving out the partial files
    # of anything unfinished.
    (cd "$DEST" && find "$top" -type f ! -name '*.part' ! -name '*.ytdl' ! -name '*.aria2') |
      while IFS= read -r f; do place "$DEST/$f" "$SHARE/$f" >/dev/null; done
    find "$DEST/$top" -depth -type d -exec rmdir {} \; 2>/dev/null  # only the empty ones
    echo "FILE: $SHARE/$top"
  elif to=$(place "$DEST/$top" "$SHARE/$top"); then
    echo "FILE: $to"
  fi
}

# place <finished file in $DEST> <where in Files>: moves it there, never over another file.
# One of the same name and size is the same download, downloaded again: then the new copy
# goes. Any other gets a name of its own, "name (2).ext". Prints where the file is.
place() {
  to=$2
  if [ -e "$to" ]; then
    size=$(stat -c %s "$1" 2>/dev/null)
    if [ -n "$size" ] && [ "$size" = "$(stat -c %s "$to" 2>/dev/null)" ]; then
      rm -f "$1"
      printf '%s\n' "$to"
      return
    fi
    base=$to ext=
    case ${to##*/} in ?*.*) base=${to%.*} ext=.${to##*.} ;; esac
    i=2
    while [ -e "$base ($i)$ext" ]; do i=$((i + 1)); done
    to="$base ($i)$ext"
  fi
  mkdir -p "${to%/*}" && timeout 1800 mv "$1" "$to" && printf '%s\n' "$to"
}

link_name() {
  if is_video_site "$1"; then
    printf '%s video' "$(host_of "$1")"
    return
  fi
  case $1 in
    magnet:*) n=$(printf %s "$1" | sed -n 's/.*[?&]dn=\([^&]*\).*/\1/p' | sed 's/+/ /g; s/%20/ /g') ;;
    *) n=${1%%[?#]*}; n=${n%/}; n=${n##*/} ;;
  esac
  printf %s "${n:-$1}"
}

# load <id>: sets link, state (running, paused, done or failed), name, path, pct, speed, eta,
# reason and via (the tool), and for a playlist: playlist, n, total, overall, videos, errors
# and stopped (it was stopped part-way, keeping the videos it had finished).
load() {
  link=$(head -n 1 "$JOBS/$1.log")
  # Only the output since the latest (re)start counts.
  seg=$(segment "$1")
  code=$(printf '%s\n' "$seg" | sed -n 's/^=== exit //p' | tail -n 1)
  reason= stopped= playlist= overall= n= total= videos=0 errors=0 prep= label=
  case $seg in *'=== via yt-dlp'*) via=yt-dlp ;; *) via=aria2 ;; esac
  case $seg in
    *'=== stopped'*) state=done stopped=1 ;;
    *'=== paused'*) state=paused ;;
    *'=== exit '*)
      if [ "$code" = 0 ]; then state=done; else state=failed; fi
      reason=$(printf '%s\n' "$seg" | grep -E 'errorCode=|^ERROR: ' | tail -n 1 |
        sed 's/.*errorCode=[0-9]* //; s/^ERROR: //; s/^\[[^]]*\] [^:]*: //; s/^Unsupported URL.*/no video found on this page/' |
        cut -c1-120) ;;
    *) if running "$1"; then state=running; else state=paused; fi ;;  # paused: iOS ended it
  esac
  # Progress lines look like [#e5d549 400KiB/1.6MiB(24%) CN:1 DL:67KiB ETA:18s] from aria2,
  # or [#yt  254.00KiB/ 815.00KiB( 31.3%) DL: 149.78KiB/s ETA:00:03] from yt-dlp.
  prog=$(printf '%s\n' "$seg" | grep '^\[#' | tail -n 1)
  pct=$(printf %s "$prog" | sed -n 's/.*( *\([0-9]*\)[.0-9]*%).*/\1/p')
  speed=$(printf %s "$prog" | sed -n 's/.* DL: *\([^] ]*\).*/\1/p')
  speed=${speed%/s}
  eta=$(printf %s "$prog" | sed -n 's/.* ETA:\([^]]*\)\].*/\1/p')
  [ "$eta" = NA ] && eta=
  # The name: the file once known (aria2 says FILE: in its summaries, yt-dlp at the end),
  # else the video's title, else something from the link.
  path=$(printf '%s\n' "$seg" | sed -n 's/^FILE: //p' | tail -n 1)
  case $path in *'[METADATA]'*) path= ;; esac  # a magnet still fetching its file list
  name=${path##*/}
  [ -n "$name" ] || name=$(printf '%s\n' "$seg" | sed -n 's/^NAME: //p' | tail -n 1)
  [ -n "$name" ] || name=$(link_name "$link")
  # What yt-dlp is doing before the download starts, from lines like
  # "[youtube] FOv2CAItUBs: Downloading player 1a2b3c4d": "Downloading player 1a2b3c4d".
  # "[youtube] [jsc:quickjs] Solving JS challenges" becomes "Solving JS challenges".
  step=$(printf '%s\n' "$seg" | grep -E '^\[[A-Za-z:_]+\] ' | grep -v -E '^\[(Exec|download|debug)\]' |
    tail -n 1 | sed 's/^\(\[[^]]*\] \)*//; s/^[^ :]*: //' | cut -c1-48)
  case $seg in *'=== moving to Files'*) step='moving to Files' pct= ;; esac
  [ "$state" = running ] && [ -z "$pct" ] && preparing
  size=
  if [ "$state" = done ]; then
    size=$(printf '%s\n' "$seg" | sed -n 's/^=== size //p' | tail -n 1)
    # Look at the file itself only when it's still in $DEST (see deliver).
    case $path in "$SHARE"/* | '') ;; *) [ -n "$size" ] || size=$(du -sh "$path" 2>/dev/null | cut -f1) ;; esac
  fi
  # A playlist: "[download] Downloading playlist: <title>", then "Downloading item 3 of 12"
  # before each video, and a FILE: line for each video that finished.
  playlist=$(printf '%s\n' "$seg" | sed -n 's/^\[download\] Downloading playlist: //p' | tail -n 1)
  [ -n "$playlist" ] || return 0
  name="📃 $playlist"
  item=$(printf '%s\n' "$seg" | sed -n 's/^\[download\] Downloading item \([0-9]*\) of \([0-9]*\)$/\1 \2/p' | tail -n 1)
  n=${item%% *} total=${item##* }
  [ -n "$item" ] || n=1 total=1
  overall=$((((n - 1) * 100 + ${pct:-0}) / total))
  videos=$(printf '%s\n' "$seg" | awk -v p="FILE: $DEST/" 'index($0, p) == 1' | wc -l)
  errors=$(printf '%s\n' "$seg" | grep -c '^ERROR: ')
  # Some videos failing doesn't make the playlist a failure.
  [ "$state" = failed ] && [ "$videos" -gt 0 ] && state=done
  case $path in "$DEST"/*/*) path=${path%/*} ;; esac  # a video in its folder: the folder
  if [ "$state" = done ] && [ -z "$size" ]; then
    case $path in "$SHARE"/*) ;; *) size=$(du -sh "$path" 2>/dev/null | cut -f1) ;; esac
  fi
}

# Before a download starts there's preparation: for YouTube a minute or more, mostly
# "Solving JS challenges". Each step yt-dlp reports stands for a share of it.
preparing() {
  case $step in
    *'Extracting URL'*) prep=8 label='opening the link' ;;
    *'Downloading webpage'*) prep=15 label='reading the page' ;;
    *'API JSON'*) prep=25 label='asking for the formats' ;;
    *'Downloading player'*) prep=35 label="getting YouTube's player" ;;
    *'Solving JS challenges'*) prep=50 label='unlocking the video link, about a minute' ;;
    *'Extracting information'*) prep=50 label='looking for the video' ;;
    *m3u8* | *MPD*) prep=80 label='getting the list of streams' ;;
    *'format(s)'*) prep=95 label='about to start' ;;
    'moving to Files') prep=100 label='moving to Files' ;;
    '')
      prep=3 label='starting'
      case $link in magnet:*) prep=10 label='looking for peers' ;; esac ;;
    *) prep=50 label=$step ;;
  esac
}

bar() {
  b= i=0
  while [ $i -lt 10 ]; do
    if [ $i -lt $(($1 / 10)) ]; then b="$b▰"; else b="$b▱"; fi
    i=$((i + 1))
  done
  printf %s "$b"
}

# One line per download. The " #<id>" at the end is how a chosen line finds its download again.
line() {
  if [ -n "$playlist" ]; then
    playlist_line "$1"
    return
  fi
  case $state in
    running)
      if [ -n "$pct" ]; then
        echo "⬇️ $(bar "$pct") $pct% · $name · ${speed:-0B}/s${eta:+ · $eta left}  #$1"
      elif [ "$label" = 'moving to Files' ]; then
        echo "📦 moving to Files… · $name  #$1"
      else
        echo "⏳ $(bar "$prep") $prep% preparing · $label… · $name  #$1"
      fi ;;
    paused) echo "⏸ ${pct:+$(bar "$pct") $pct% · }$name · paused  #$1" ;;
    done) echo "✅ $name${size:+ · $size}  #$1" ;;
    failed) echo "⚠️ $name · failed${reason:+: $reason}  #$1" ;;
  esac
}

# The bar for a playlist is the whole playlist: video 3 of 12 at 50% is 21%.
playlist_line() {
  case $state in
    running)
      if [ -n "$pct" ]; then
        now="$pct% · ${speed:-0B}/s"
      else
        now="preparing · $label…"
      fi
      echo "⬇️ $(bar "$overall") video $n of $total · $now · $name  #$1" ;;
    paused) echo "⏸ $(bar "$overall") video $n of $total · $name · paused  #$1" ;;
    done)
      failed=
      [ "$errors" -gt 0 ] && failed=", $errors failed"
      echo "✅ $name · $videos videos$failed${size:+ · $size}  #$1" ;;
    failed) echo "⚠️ $name · failed${reason:+: $reason}  #$1" ;;
  esac
}

status() {
  set -- $(ids | head -n $SHOWN)
  [ $# -gt 0 ] || { echo "No downloads yet."; return; }
  for id; do
    load "$id"
    line "$id"
  done
}

add() {  # add <link>: start it, or resume it if it's already in the list
  for id in $(ids); do
    [ "$(head -n 1 "$JOBS/$id.log")" = "$1" ] || continue
    load "$id"
    case $state in
      running) echo "Already downloading: $name" ;;
      done)
        if [ -n "$stopped" ]; then
          echo "You stopped $playlist part-way. To download it again, remove it from the list first."
        else
          echo "Already downloaded: $name (clear finished to download it again)"
        fi ;;
      *) start "$1" "$id"; echo "Resumed: $name" ;;
    esac
    return
  done
  last=$(ids | head -n 1)
  start "$1" $((${last:-0} + 1))
  echo "Started: $(link_name "$1")"
}

links_in() {  # links_in <text>: the links in it, one a line
  # Drop punctuation that ends a sentence rather than the link ("see https://x.com/a.zip.").
  # YouTube's share links carry a "si=" tracking tag that differs on every share; drop it,
  # so sharing the same video twice is the same download.
  printf '%s\n' "$1" | grep -oE "$LINK_RE" | sed 's/[.,;:!?]*$//' |
    sed -E '/^https?:\/\/([a-z]+\.)?(youtube\.com|youtu\.be)\//{s/([?&])si=[^&]*&?/\1/; s/[?&]$//;}'
}

# incoming <text> <share|menu>: links shared to the Shortcut, or pasted in its menu (level
# 4). One link to a video page asks how to download it: quickly, by the rule in Settings,
# or in a quality picked from a list. Unless Settings says not to ask; and anything else
# starts at once. Fails after an answer for the Shortcut.
incoming() {
  from=$2
  link=$(links_in "$1")
  if [ ! -e "$JOBS/.no-ask" ] && [ -z "$(find "$JOBS" -maxdepth 1 -name .bark-next -mmin -5 2>/dev/null)" ] &&
      [ -n "$link" ] && [ "$(printf '%s\n' "$link" | wc -l)" = 1 ] && page "$link"; then
    choose "$link" "$from"
    screen=choose
    return 0
  fi
  finish "$(add_links "$1")"
}

page() {  # page <link>: is it a page, which may have a video in it, rather than a file?
  is_video_site "$1" && return 0
  case $1 in "$BARK"/* | magnet:* | *ftp:*) return 1 ;; esac
  end=${1%%[?#]*}
  end=${end%/}
  end=${end##*/}
  case $end in *.htm | *.html | *.php | *.asp | *.aspx) return 0 ;; *.*) return 1 ;; esac
}

add_links() {
  links=$(links_in "$1")
  # "3️⃣ Then tap here" on the notifications screen sends the clipboard here, expecting a
  # link from Bark. Anything else on the clipboard then isn't meant to be downloaded.
  if [ -n "$(find "$JOBS" -maxdepth 1 -name .bark-next -mmin -5 2>/dev/null)" ] &&
      ! printf '%s\n' "$links" | grep -q "^$BARK/"; then
    rm -f "$JOBS/.bark-next"
    echo "There's no Bark link on the clipboard. In Bark, tap the copy button next to one of its links, then tap 3️⃣ again."
    return 1
  fi
  rm -f "$JOBS/.bark-next"
  if [ -z "$links" ]; then
    echo "No link found in: $1"
    return 1
  fi
  printf '%s\n' "$links" | while IFS= read -r link; do
    case $link in "$BARK"/?*) bark_link "$link" ;; *) add "$link" ;; esac
  done
}

# Bark shows links like https://api.day.app/<key>/Title/Body, ready to copy. The key is
# what notifications are sent with. It's kept only once Bark has taken a test with it.
bark_link() {  # bark_link <link from Bark>
  key=${1#"$BARK"/}
  key=${key%%[/?#]*}
  case $key in '' | *[!A-Za-z0-9]*) echo "That Bark link has no key in it."; return 1 ;; esac
  if out=$(bark "🔔 aria2 notifications are on" "You'll get one like this when a download finishes. Tap it to open the download." \
      "$(files_url "$SHARE")" "$BARK/$key" 2>&1); then
    echo "$BARK/$key" >"$JOBS/.bark"
    rm -f "$JOBS/.bark.off"
    echo "Notifications are on. Bark just sent you a test one."
  else
    echo "Bark didn't take that link, so notifications are still off. ${out#curl: (*) }"
    return 1
  fi
}

bark() {  # bark <title> <text> [<link it opens when tapped> [<where to send it>]]
  to=${4:-$(cat "$JOBS/.bark" 2>/dev/null)}
  [ -n "$to" ] || return 1
  json="{\"title\": \"$(json_text "$1")\", \"body\": \"$(json_text "$2")\", \"group\": \"aria2\""
  [ -z "$3" ] || json="$json, \"url\": \"$(json_text "$3")\""
  # Short enough for the Shortcut's Run Command, which gives up after 20 seconds.
  timeout 15 curl -fsS -m 12 -o /dev/null -H 'Content-Type: application/json; charset=utf-8' \
    -d "$json}" "$to"
}

json_text() { printf %s "$1" | tr -d '\001-\037' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# When notifications are on: one when a download finishes, which opens it in the Files app
# when tapped, and one when it fails. None for a pause.
announce() {  # announce <id>
  [ -s "$JOBS/.bark" ] || return 0
  segment "$1" | grep -q '^=== paused' && return 0  # paused, or being stopped
  load "$1"
  case $state in
    done)
      title='✅ Downloaded'
      what=$(line "$1")
      what=${what#* }    # the list's line without its ✅
      what=${what%  #*}  # and without its number
      url=$(files_url "$path") ;;
    failed) title='⚠️ Download failed' what="$name${reason:+: $reason}" url= ;;
    *) return 0 ;;
  esac
  # The phone may only just have got its connection back.
  for try in 1 2 3; do
    bark "$title" "$what" "$url" 2>/dev/null && return 0
    sleep 10
  done
}

# Stop a download politely: aria2 and yt-dlp keep what they have, and starting the same
# link again carries on from there.
pause() {  # pause <id>
  pid=$(cat "$JOBS/$1.pid" 2>/dev/null)
  alive "$pid" "$1" || return 0
  echo "=== paused" >>"$JOBS/$1.log"
  kill -TERM -"$pid" 2>/dev/null || kill -TERM "$pid"
  for try in 1 2 3 4 5; do
    alive "$pid" "$1" || return 0
    sleep 1
  done
}

toggle() {  # toggle <id>
  [ -f "$JOBS/$1.log" ] || { echo "That download is no longer in the list."; return; }
  load "$1"
  case $state in
    running) pause "$1"; rest_unless_busy; echo "Paused: $name" ;;
    done) echo "Already finished: $name" ;;
    *) start "$link" "$1"; echo "Resumed: $name" ;;
  esac
}

pause_all() {
  count=0
  for id in $(ids); do
    # By state, not by worker: a finished download's worker may still be updating tools.
    load "$id"
    [ "$state" = running ] || continue
    pause "$id"
    count=$((count + 1))
  done
  rest_unless_busy
  if [ $count = 0 ]; then echo "Nothing is downloading."; else echo "Paused all downloads."; fi
}

resume_all() {
  count=0
  for id in $(ids); do
    load "$id"
    [ "$state" = paused ] || continue
    start "$link" "$id"
    count=$((count + 1))
  done
  echo "Resumed $count download(s)."
}

clear_finished() {
  count=0
  for id in $(ids); do
    load "$id"
    case $state in done | failed) forget "$id"; count=$((count + 1)) ;; esac
  done
  echo "Cleared $count finished download(s)"
  echo "The files are still in Downloads"
}

# dl -m and dl -a are the menu of the first single shortcut, kept for phones that haven't
# imported the newer one (see dl -ui below). It handles ➕, 📲 and ❌ itself.
actions() {
  # An update that brought a new shortcut says where it is, until this line is tapped.
  [ -s "$SHORTCUTS/.pending" ] &&
    echo "🆕 New shortcut: $(cat "$SHORTCUTS/.pending"). Open it, tap Replace, then tap here."
  [ -d "$JOBS/.updating" ] && echo "🔧 Updating yt-dlp and the other tools…"
  echo "➕ Add link from clipboard"
  echo "⏸ Pause all"
  echo "▶️ Resume all"
  echo "🧹 Clear finished"
  echo "🔧 Update tools"
  echo "🔄 Refresh"
  echo "📲 Open iSH-AOK"
  echo "❌ Close"
}

act() {  # act <chosen menu line>
  case $1 in
    *' #'[0-9]*)
      id=${1##*#}
      case $id in *[!0-9]*) ;; *) toggle "$id" ;; esac ;;
    *'Pause all') pause_all ;;
    *'Resume all') resume_all ;;
    *'Clear finished') clear_finished ;;
    *'Update tools') update_in_background both; echo "Updating aria2 and its tools in the background." ;;
    '🆕'*) rm -f "$SHORTCUTS/.pending"; echo "Done." ;;
    *) ;;  # Refresh: the Shortcut shows the list again anyway
  esac
}

# ---- The Shortcut's screens ----
#
# The Shortcut runs `dl -ui -b '<what was tapped, base64>' -k <its version>` again and again,
# and shows what it prints. It sends "@@start" when it opens, and nothing after it handled
# a tap itself. A few answers it acts on instead of showing them:
#   @@open:<link>   opens the link: a file or folder in Files, or the App Store
#   @@import        runs `dl --shortcut` and opens the file it prints, the new shortcut, so
#                   that iOS offers to import it
#   @@clipboard     adds the link on the clipboard
#   @@app           opens iSH-AOK
#   @@exit          closes
# and, from shortcuts of level 3 on, without closing:
#   @@web:<link>    shows the page in a Safari sheet: the live view, or the player
#   @@copy:<text>   copies the text
#   @@share:<text>  shares the text
# and, from level 4:
#   @@notify:<text> shows a notification, and closes
# A shortcut of level 4 also sends what was shared to it as "@@add:<text>", and the link on
# the clipboard (after @@clipboard) as "@@paste:<text>", instead of running dl -b itself,
# so that a video can ask how to download it (see incoming).
# Anything else is a screen of rows: vCards, which Choose from List shows as contacts, each
# with a picture, a title and a line under it (the "vCard menu" trick, as in Cherri's
# chooseFromVCard), or plain lines when pictures are off. What comes back is what the row
# showed: a vCard's title, or the whole line. So every screen lives here, and changing one
# never needs a new shortcut.
#
# A shortcut's version says what it can do: "<level>-<hash>" from level 3 on. c1a2b4d4,
# level 2, has pictures but no @@web, @@copy or @@share. The one before pictures
# (c819f7f3), level 0, sends no -k: it gets plain lines, opens only shareddocuments://
# links as they are, and knows no @@import.
#
# Kept in $JOBS: .screen (main, list, "item <id>", "confirm <id>", settings or
# notifications), .menu (one line per row on show: its key, a tab, then what it showed)
# and .notice (a message for the next screen: a title line, then a detail line).

KEEP_FINISHED=6  # finished downloads the list keeps; older ones drop off it (files stay)
ICONS=${DL_ICONS:-/usr/local/share/dl/icons}  # the pictures, base64 PNGs, from setup
BARK_APP=https://apps.apple.com/app/bark-custom-notifications/id1403753865
WEB=${DL_WEB:-/usr/local/share/dl/web.py}  # the live view's server, from setup
WEB_PORT=${DL_WEB_PORT:-8486}

ui() {  # ui <what was tapped>
  screen=$(cat "$JOBS/.screen" 2>/dev/null)
  LEVEL=0
  [ -n "$SHORTCUT" ] && LEVEL=2
  case $SHORTCUT in [0-9]*-*) LEVEL=${SHORTCUT%%-*} ;; esac
  case $1 in
    @@start) screen=main; opening || return 0 ;;
    @@add:*) incoming "${1#@@add:}" share || return 0 ;;    # shared to the Shortcut
    @@paste:*) incoming "${1#@@paste:}" menu || return 0 ;;  # ➕, from the clipboard
    '') ;;
    *) tapped "$(row_key "$1")" || return 0 ;;
  esac
  cards=  # pictures, unless they're off or the shortcut can't show them
  [ -n "$SHORTCUT" ] && [ ! -e "$JOBS/.plain" ] && cards=1
  echo "$screen" >"$JOBS/.screen"
  rows=$JOBS/.rows.$$
  : >"$rows"
  if [ -s "$JOBS/.notice" ]; then
    { IFS= read -r title; IFS= read -r detail; } <"$JOBS/.notice"
    row notice ℹ️ "$title" "$detail"
    : >"$JOBS/.notice"
  fi
  case $screen in
    list) list_screen ;;
    item\ *) item_screen "${screen#item }" ;;
    confirm\ *) confirm_screen "${screen#confirm }" ;;
    choose) choose_screen ;;
    pick) pick_screen ;;
    sound) sound_screen ;;
    quality) quality_screen ;;
    settings) settings_screen ;;
    notifications) notifications_screen ;;
    *) main_screen ;;
  esac
  render <"$rows"
  rm -f "$JOBS/.rows.$$"
}

row() {  # row <key> <emoji> <title> [<detail> [<picture>]]: add a row to the screen
  printf '%s\037%s\037%s\037%s\037%s\n' "$1" "$2" "$3" "$4" "$5" >>"$rows"
}

notice() { printf '%s\n%s\n' "$1" "$2" >"$JOBS/.notice"; }  # notice <title> [<detail>]

# Prints the rows as vCards or lines, and keeps what each showed in .menu. Rows have to
# read differently from each other, because what was tapped is all that comes back.
render() {
  awk -F '\037' -v cards="$cards" -v icons="$ICONS" -v menu="$JOBS/.menu" '
    BEGIN {
      # The picture for each emoji, unless the row names one.
      n = split("⬅️ back 📥 downloads ⬇️ downloads ➕ add 📂 folder 📦 folder ⚙️ settings 🆕 new " \
        "🔔 bell 🔕 belloff ⬆️ update 🔧 tools 📲 app ⏸ pause ▶️ play ⏹ stop 🔁 retry " \
        "🔄 refresh 🗑 trash ℹ️ info ✅ done ⚠️ failed 🧹 clear 🖼 pictures ⏳ prep0 " \
        "1️⃣ appstore 2️⃣ copy 3️⃣ paste 📊 live 📤 share 🔗 copy ➖ remove 🐞 bug " \
        "🎬 video 🎵 music ⚡ bolt 🎚 sliders 🔇 mute ⚪ unchecked 📃 playlist", w, " ")
      for (i = 1; i < n; i += 2) pic[w[i]] = w[i + 1]
      printf "" > menu
    }
    function first(c) { return c < "\200" || c >= "\300" }  # starts a UTF-8 character
    # s cut to n characters (not bytes: titles are often in other scripts), with "…".
    function cut(s, n,   i, chars) {
      for (i = 1; i <= length(s); i++) chars += first(substr(s, i, 1))
      if (chars <= n) return s
      chars = 0
      for (i = 1; i <= length(s); i++)
        if (first(substr(s, i, 1)) && ++chars == n) break
      s = substr(s, 1, i - 1)
      sub(/[ .,:;(-]+$/, "", s)
      return s "…"
    }
    function esc(s,   i, c, out) {  # for a vCard value
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        out = out (c == "\\" || c == "," || c == ";" ? "\\" : "") c
      }
      return out
    }
    function photo(name,   f, data) {  # a picture by name, or a file of base64 by path
      f = name ~ /^\// ? name : icons "/" name ".b64"
      if ((getline data < f) <= 0) data = ""
      close(f)
      return data
    }
    {
      key = $1; emoji = $2; title = $3; detail = $4; p = $5
      gsub(/[[:cntrl:]]/, " ", title); gsub(/[[:cntrl:]]/, " ", detail)
      title = cut(title, cards ? 38 : 30); detail = cut(detail, cards ? 60 : 40)
      for (k = 1; ; k++) {
        t = k == 1 ? title : title " (" k ")"
        shown = cards ? t : emoji " " t (detail == "" ? "" : " · " detail)
        if (!(shown in seen)) break
      }
      seen[shown] = 1
      print key "\t" shown > menu
      if (!cards) { print shown; next }
      print "BEGIN:VCARD\nVERSION:3.0\nN;CHARSET=utf-8:" esc(t) ";;;;"
      if (detail != "") print "ORG;CHARSET=utf-8:" esc(detail) ";"
      data = photo(p == "" ? pic[emoji] : p)
      if (data != "") print "PHOTO;ENCODING=b:" data
      print "END:VCARD"
    }
    END { close(menu) }'
}

row_key() {  # row_key <what was tapped>: the key of the row that showed it
  # If the text comes back changed (escapes or spaces), match it loosely.
  TAPPED=$1 awk -F '\t' '
    function plain(s) { gsub(/[\\ ]/, "", s); return tolower(s) }
    BEGIN { t = ENVIRON["TAPPED"]; p = plain(t) }
    $2 == t { print $1; exact = 1; exit }
    loose == "" && plain($2) == p { loose = $1 }
    END { if (!exact && loose != "") print loose }' "$JOBS/.menu" 2>/dev/null
}

tapped() {  # tapped <key>: act on the row tapped. Fails after printing an answer for the Shortcut.
  id=${screen#* }  # on the screen of one download: "item <id>" or "confirm <id>"
  case $1 in
    '' | notice | self) ;;  # just show the screen again
    back:*) screen=${1#back:} ;;
    downloads) screen=list ;;
    add) echo @@clipboard; return 1 ;;
    folder) open_link "$(files_url "$SHARE" || echo shareddocuments://)"; return 1 ;;
    settings) screen=settings ;;
    import) import_shortcut || return 1 ;;
    dl:*) screen="item ${1#dl:}" ;;
    live) open_web / || return 1 ;;
    live:*) open_web / "${1#live:}" || return 1 ;;  # scrolled to that download
    pauseall) notice "$(pause_all)" ;;
    resumeall) notice "$(resume_all)" ;;
    clear) notice "$(clear_finished)" ;;
    pause) pause "$id"; rest_unless_busy ;;
    resume) load "$id"; start "$link" "$id" ;;
    stop) notice "$(stop "$id")"; screen=list ;;
    remove) load "$id"; forget "$id"; notice "Removed from the list" "${playlist:-$name}"; screen=list ;;
    open) open_download "$id" || return 1 ;;
    show) show_folder "$id" || return 1 ;;
    again) notice "$(again "$id")"; screen=list ;;
    copy) load "$id"; copy_text "$link" || return 1 ;;
    share) load "$id"; echo "@@share:$link"; return 1 ;;
    delete) screen="confirm $id" ;;
    # Choosing how to download a video (see choose)
    quick) chosen "$(rule_format | sed -n 1p)" "$(rule_format | sed -n 2p)" || return 1 ;;
    audio-quick) chosen "$(rule_format audio | sed -n 1p)" audio || return 1 ;;
    rule:*)
      chosen "$(rule_format "${1#rule:}" | sed -n 1p)" "$(rule_format "${1#rule:}" | sed -n 2p)" || return 1 ;;
    pick)
      probe_start
      probe_wait 80  # the Shortcut waits up to 120 s for this one
      screen=pick ;;
    v:*)
      spec=${1#v:}
      if [ "${spec##*:}" = 1 ]; then  # it has its own sound
        chosen "${spec%:*}" || return 1
      else
        echo "${spec%:*}" >"$CHOICE/video"
        screen=sound
      fi ;;
    a-only) echo none >"$CHOICE/video"; screen=sound ;;
    a:*)
      video=$(cat "$CHOICE/video" 2>/dev/null)
      case ${1#a:}:$video in
        none:*) chosen "$video" || return 1 ;;              # no sound
        *:none) chosen "${1#a:}" audio || return 1 ;;       # sound only
        *) chosen "$video+${1#a:}" || return 1 ;;
      esac ;;
    cancel)
      from=$(cat "$CHOICE/from" 2>/dev/null)
      rm -rf "$CHOICE"
      if [ "$from" = share ]; then echo @@exit; return 1; fi
      screen=main ;;
    quality) screen=quality ;;
    rule-set:*) echo "${1#rule-set:}" >"$JOBS/.quality" ;;
    ask) flip .no-ask ;;
    delete-yes) notice "$(delete_download "$id")"; screen=list ;;
    report) report_answer || return 1 ;;
    report:*) report_answer "${1#report:}" || return 1 ;;
    notifications) screen=notifications ;;
    update-app)
      if [ -s "$SHORTCUTS/.pending" ]; then
        import_shortcut || return 1
      elif [ ! -d "$JOBS/.app-updating" ]; then
        update_in_background app
        notice "Checking for a new version" "Tap ⬆️ again to see how it's going"
      fi ;;
    update-tools)
      if [ ! -d "$JOBS/.updating" ]; then
        update_in_background tools
        notice "Updating the tools" "Tap 🔧 again to see how it's going"
      fi ;;
    auto) flip .no-auto-update ;;
    pictures) flip .plain ;;
    ish) echo @@app; return 1 ;;
    bark-store) open_link "$BARK_APP"; return 1 ;;
    bark-paste) : >"$JOBS/.bark-next"; echo @@clipboard; return 1 ;;  # see add_links
    bark-on) mv "$JOBS/.bark.off" "$JOBS/.bark" 2>/dev/null ;;
    bark-test)
      if out=$(bark "🔔 Test from aria2" "Tapping this opens your Downloads folder." "$(files_url "$SHARE")" 2>&1); then
        notice "Sent a test notification" "If none arrives, allow Bark's notifications in Settings → Apps → Bark"
      else
        notice "Bark didn't take it" "${out#curl: (*) }"
      fi ;;
    bark-off) mv "$JOBS/.bark" "$JOBS/.bark.off" 2>/dev/null; notice "Notifications are off" ;;
  esac
  return 0
}

flip() {  # flip <setting>: a file in $JOBS that's there when it's on
  if [ -e "$JOBS/$1" ]; then rm -f "$JOBS/$1"; else : >"$JOBS/$1"; fi
}

open_link() {  # open_link <link>: the answer that opens it
  if [ -n "$SHORTCUT" ]; then echo "@@open:$1"; else echo "$1"; fi
}

# When the Shortcut opens: see whether it's the new shortcut, offer a new one (once), and
# start any update that's due. Fails after printing an answer for the Shortcut.
opening() {
  version=$(cat "$SHORTCUTS/.version" 2>/dev/null)
  [ -n "$SHORTCUT" ] && [ "$SHORTCUT" = "$version" ] && rm -f "$SHORTCUTS/.pending"
  if auto_updates; then
    due "$JOBS/.app-checked" 21600 && [ ! -d "$JOBS/.app-updating" ] && update_in_background app
    due "$JOBS/.updated" 86400 && [ ! -d "$JOBS/.updating" ] && update_in_background tools
  fi
  if [ -s "$SHORTCUTS/.pending" ] && [ "$(cat "$SHORTCUTS/.offered" 2>/dev/null)" != "$version" ]; then
    echo "$version" >"$SHORTCUTS/.offered"
    import_shortcut || return 1
  fi
  return 0
}

# The answer that gets the new shortcut imported (and fails), or else a notice saying
# where it is. Setup writes where it put the file into .pending.
import_shortcut() {
  if [ -n "$SHORTCUT" ] && [ -s "$SHORTCUTS/aria2.shortcut" ]; then
    echo @@import
    return 1
  fi
  where=$(cat "$SHORTCUTS/.pending" 2>/dev/null)
  if url=$(files_url "$where"); then
    echo "$url"
    return 1
  fi
  notice "Open the new shortcut in Files" "$where"
  return 0
}

main_screen() {
  [ -s "$SHORTCUTS/.pending" ] && row import 🆕 "New aria2 shortcut" "Tap to install it, then tap Replace"
  running=0 paused=0 finished=0 sum=0 known=0
  for id in $(ids); do
    load "$id"
    case $state in
      running)
        running=$((running + 1))
        [ -n "$pct" ] && sum=$((sum + ${overall:-$pct})) known=$((known + 1)) ;;
      paused) paused=$((paused + 1)) ;;
      *) finished=$((finished + 1)) ;;
    esac
  done
  s=
  [ $running = 0 ] || s="$s · $running downloading"
  [ $paused = 0 ] || s="$s · $paused paused"
  [ $finished = 0 ] || s="$s · $finished finished"
  s=${s#" · "}
  pic=downloads
  [ $known = 0 ] || pic=ring$(((sum / known + 5) / 10 * 10))
  row downloads 📥 Downloads "${s:-Nothing yet: share a link to aria2}" "$pic"
  row add ➕ "Add link from clipboard" "Copy a link, then tap here"
  row folder 📂 "Downloads folder" "Open it in Files"
  s="Notifications $(on_off "$JOBS/.bark")"
  if [ -d "$JOBS/.updating" ] || [ -d "$JOBS/.app-updating" ]; then
    s="$s · updating…"
  elif auto_updates; then
    s="$s · automatic updates"
  fi
  row settings ⚙️ Settings "$s"
}

on_off() { if [ -s "$1" ]; then echo on; else echo off; fi; }  # on_off <file>

# Sets emoji, title, detail and pic: how download <id> shows in the list, after load.
describe() {
  title=${playlist:-$name}
  case $state in
    running)
      if [ -n "$playlist" ]; then
        emoji=⬇️ pic=ring$(((overall + 5) / 10 * 10))
        if [ -n "$pct" ]; then
          detail="Video $n of $total · $pct% · ${speed:-0B}/s"
        else
          detail="Video $n of $total · preparing · $label"
        fi
      elif [ -n "$pct" ]; then
        emoji=⬇️ pic=ring$(((pct + 5) / 10 * 10)) detail="$pct% · ${speed:-0B}/s${eta:+ · $eta left}"
      elif [ "$label" = 'moving to Files' ]; then
        emoji=📦 pic=folder detail='Moving to Files…'
      else
        emoji=⏳ pic=prep$(((prep + 5) / 10 * 10)) detail="Preparing $prep% · $label…"
      fi ;;
    paused)
      emoji=⏸ pic=paused detail="Paused${pct:+ at $pct%}"
      [ -n "$playlist" ] && detail="Paused · video $n of $total" ;;
    done)
      emoji=✅ pic=done detail=Downloaded
      # A video's file name is its title; the list doesn't need the .mp4.
      [ "$via" = yt-dlp ] && [ -n "$path" ] && title=${title%.*}
      if [ -n "$playlist" ]; then
        title=$playlist pic=playlist detail="$videos videos"
        [ "$errors" -gt 0 ] && detail="$detail · $errors failed"
        [ -n "$stopped" ] && detail="Stopped · $videos of $total videos"
      fi
      detail="$detail${size:+ · $size}"
      [ -s "$JOBS/$1.thumb" ] && pic=$JOBS/$1.thumb ;;
    failed) emoji=⚠️ pic=failed detail="Failed${reason:+: $reason}" ;;
  esac
}

list_screen() {
  prune
  row back:main ⬅️ Back
  set -- $(ids | head -n $SHOWN)
  [ $# -gt 0 ] || row notice ℹ️ "No downloads yet" "Share a link to aria2 to start one"
  running= paused= finished=
  # The downloads' rows go aside first: the live view's row comes before them, if anything
  # is running.
  screen_rows=$rows rows=$rows.list
  : >"$rows"
  for id; do
    load "$id"
    describe "$id"
    row "dl:$id" "$emoji" "$title" "$detail" "$pic"
    case $state in running) running=1 ;; paused) paused=1 ;; *) finished=1 ;; esac
  done
  rows=$screen_rows
  [ -n "$running" ] && web_ok && row live 📊 "Watch live" "Progress bars that move as they download"
  cat "$rows.list" >>"$rows"
  rm -f "$JOBS/.rows.$$.list"
  [ -n "$running" ] && row pauseall ⏸ "Pause all"
  [ -n "$paused" ] && row resumeall ▶️ "Resume all"
  [ -n "$finished" ] && row clear 🧹 "Clear finished" "The files stay in Downloads"
  row self 🔄 Refresh
}

item_screen() {  # item_screen <id>
  if [ ! -f "$JOBS/$1.log" ]; then
    echo list >"$JOBS/.screen"
    list_screen
    return
  fi
  row back:list ⬅️ Back
  load "$1"
  describe "$1"
  [ -s "$JOBS/$1.thumb" ] && pic=$JOBS/$1.thumb
  [ "$state" = done ] && detail="$detail · $(ago_of "$JOBS/$1.log")"
  row self "$emoji" "$title" "$detail" "$pic"
  from=$(host_of "$link")
  case $link in magnet:*) from="a magnet link" ;; esac
  case $state in
    running)
      row pause ⏸ Pause "Resume it any time"
      web_ok && row "live:$1" 📊 "Watch live" "A progress bar that moves as it downloads"
      stop_row ;;
    paused) row resume ▶️ Resume "From where it stopped"; stop_row ;;
    failed)
      row resume 🔁 "Try again" "From where it stopped"
      report_row "report:$1" "What went wrong" ;;
    done)
      if web_ok; then
        row open ▶️ Open "Plays it right here"
      else
        row open ▶️ Open "In the Files app"
      fi
      row show 📂 "Show in folder" "$(folder_name)"
      row again 🔁 "Download again" "In case it was moved or deleted" ;;
  esac
  row copy 🔗 "Copy link" "$from"
  [ "$LEVEL" -ge 3 ] && row share 📤 "Share link" "$from"
  case $state in
    done) row remove ➖ "Remove from the list" "The file stays where it is" ;;
    failed) row remove ➖ "Remove from the list" ;;
  esac
  # Only a single file: a playlist's folder may hold more than this download put there.
  if [ "$state" = done ] && [ -z "$playlist" ]; then
    case $path in "$SHARE"/?* | "$DEST"/?*) row delete 🗑 "Delete the file…" "Asks first" ;; esac
  fi
}

# How to download a video: quickly, by the rule, or in a quality picked from a list.
choose_screen() {
  link=$(cat "$CHOICE/link" 2>/dev/null)
  if [ -z "$link" ]; then  # nothing being chosen any more
    echo main >"$JOBS/.screen"
    main_screen
    return
  fi
  row cancel ⬅️ Cancel
  title=$(choice_field title)
  pic=
  [ -s "$CHOICE/thumb" ] && pic=$CHOICE/thumb
  row self 🎬 "${title:-$(link_name "$link")}" "$(host_of "$link")" "$pic"
  row quick ⚡ "Quick download" "$(rule_label) · $(rule_detail)"
  row pick 🎚 "Choose the quality" "Pick the video and the sound"
  [ "$(cat "$JOBS/.quality" 2>/dev/null)" = audio ] || row audio-quick 🎵 "Audio only" "Just the sound, as M4A"
}

pick_screen() {  # the qualities yt-dlp found
  row back:choose ⬅️ Back
  if [ -e "$CHOICE/failed" ]; then
    row notice ⚠️ "Couldn't find the qualities" "$(sed -n 's/^ERROR: //p' "$CHOICE/log" | tail -n 1)"
    row quick ⚡ "Quick download instead" "$(rule_label) · $(rule_detail)"
    return
  elif [ ! -e "$CHOICE/done" ]; then
    row pick ⏳ "Still finding the qualities…" "Tap to wait a little longer"
    row quick ⚡ "Quick download instead" "$(rule_label) · $(rule_detail)"
    return
  fi
  pic=
  [ -s "$CHOICE/thumb" ] && pic=$CHOICE/thumb
  count=$(choice_field playlist)
  if [ -n "$count" ]; then  # a playlist: one quality for all its videos
    row self 📃 "$(choice_field title)" "$count videos: pick a quality for all of them" "$pic"
    for rule in iphone best 720 480 audio; do
      if [ $rule = audio ]; then e=🎵; else e=🎬; fi
      row "rule:$rule" $e "$(rule_label $rule)" "$(rule_detail $rule)"
    done
    return
  fi
  row self 🎬 "$(choice_field title)" "Pick the video's quality" "$pic"
  awk -F '\037' '$1 == "video"' "$CHOICE/rows" | while IFS=$(printf '\037') read -r kind spec label detail own; do
    row "v:$spec:$own" 🎬 "$label" "$detail"
  done
  grep -q "^audio$(printf '\037')" "$CHOICE/rows" && row a-only 🎵 "Audio only" "Pick the sound next"
}

sound_screen() {  # the sounds, once a video is picked (or none, for sound only)
  row back:pick ⬅️ Back
  video=$(cat "$CHOICE/video" 2>/dev/null)
  pic=
  [ -s "$CHOICE/thumb" ] && pic=$CHOICE/thumb
  if [ "$video" = none ]; then
    row self 🎵 "$(choice_field title)" "Pick the sound's quality" "$pic"
  else
    row self 🎬 "$(choice_field title)" "Pick the sound to go with it" "$pic"
  fi
  awk -F '\037' '$1 == "audio"' "$CHOICE/rows" | while IFS=$(printf '\037') read -r kind spec label detail; do
    row "a:$spec" 🎵 "$label" "$detail"
  done
  [ "$video" = none ] || row a:none 🔇 "No sound" "Just the video"
}

quality_screen() {  # Settings → Quick download: the rule, and whether to ask
  row back:settings ⬅️ Back
  current=$(cat "$JOBS/.quality" 2>/dev/null)
  for rule in iphone best 720 480 audio; do
    if [ "$rule" = "${current:-iphone}" ]; then e=✅; else e=⚪; fi
    row "rule-set:$rule" "$e" "$(rule_label $rule)" "$(rule_detail $rule)"
  done
  [ "$LEVEL" -ge 4 ] || return 0
  if [ -e "$JOBS/.no-ask" ]; then
    row ask 🎚 "Ask when sharing a video · Off" "It downloads at once, by the rule above"
  else
    row ask 🎚 "Ask when sharing a video · On" "Quick download, or choose the quality"
  fi
}

confirm_screen() {  # confirm_screen <id>: are you sure you want to delete its file?
  load "$1"
  row notice ⚠️ "Delete $name?" "It goes for good, from Files too"
  row delete-yes 🗑 "Yes, delete it"
  row "back:item $1" ⬅️ "No, keep it"
}

ago_of() {  # ago_of <file>: how long since it last changed, e.g. "3 h ago"
  date -r "$1" +%s >"$JOBS/.ago.$$" 2>/dev/null && ago "$JOBS/.ago.$$"
  rm -f "$JOBS/.ago.$$"
}

# Where a finished download's file is, for its "Show in folder" row: the folder's name.
folder_name() {
  case $path in
    "$SHARE"/*)
      dir=$path
      [ -n "$playlist" ] || dir=${path%/*}
      if [ "$dir" = "$SHARE" ]; then dir=$(share_host); fi
      echo "In Files: ${dir##*/}" ;;
    *) echo "In iSH-AOK's own Downloads folder" ;;
  esac
}

# A playlist that has finished some videos keeps them when it's stopped.
stop_row() {
  if [ -n "$playlist" ] && [ "$videos" -gt 0 ]; then
    row stop ⏹ "Stop here" "Keeps the $videos finished video(s)"
  else
    row stop ⏹ "Stop and delete" "Deletes what it downloaded so far"
  fi
}

settings_screen() {
  row back:main ⬅️ Back
  row quality ⚡ "Quick download" "$(rule_label) · $(rule_detail)"
  if [ -s "$JOBS/.bark" ]; then
    row notifications 🔔 Notifications "On: one when a download finishes"
  else
    row notifications 🔕 Notifications "Off · tap to set up"
  fi
  row update-app ⬆️ "aria2 and its shortcut" "$(app_status)"
  row update-tools 🔧 "Tools: yt-dlp, aria2, ffmpeg" "$(tools_status)"
  if auto_updates; then
    row auto 🔁 "Automatic updates" "On: tools daily, aria2 when you open it" auto
  else
    row auto 🔁 "Automatic updates" "Off" auto
  fi
  if [ -n "$SHORTCUT" ]; then
    row pictures 🖼 "Pictures in menus" "$(on_off_flag "$JOBS/.plain")"
  fi
  report_row report "Everything aria2 knows"
  row ish 📲 "Open iSH-AOK" "The terminal behind aria2"
}

on_off_flag() { if [ -e "$1" ]; then echo Off; else echo On; fi; }  # On unless <file> is there

app_status() {
  if [ -d "$JOBS/.app-updating" ]; then
    step=$(sed -n 's/^=== app //p' "$JOBS/.app-update.log" 2>/dev/null | tail -n 1)
    echo "${step:-Checking for a new version}…"
  elif [ -s "$SHORTCUTS/.pending" ]; then
    echo "New shortcut ready · tap to install"
  elif [ -s "$JOBS/.app-checked" ]; then
    echo "Up to date · checked $(ago "$JOBS/.app-checked")"
  else
    echo "Tap to check for a new version"
  fi
}

tools_status() {
  if [ -d "$JOBS/.updating" ]; then
    update_progress
  elif [ -s "$JOBS/.updated" ]; then
    v=$(cat "$JOBS/.yt-dlp-version" 2>/dev/null)
    echo "Updated $(ago "$JOBS/.updated")${v:+ · yt-dlp $v}"
  else
    echo "Tap to update them"
  fi
}

ago() {  # ago <file with a time in it>: e.g. "3 h ago"
  s=$(($(date +%s) - $(cat "$1")))
  if [ $s -lt 120 ]; then echo "just now"
  elif [ $s -lt 7200 ]; then echo "$((s / 60)) min ago"
  elif [ $s -lt 172800 ]; then echo "$((s / 3600)) h ago"
  else echo "$((s / 86400)) days ago"
  fi
}

notifications_screen() {
  row back:settings ⬅️ Back
  if [ -s "$JOBS/.bark" ]; then
    row notice ✅ "Notifications are on" "One when a download finishes. Tap it to open the download."
    row bark-test 🔔 "Send a test notification"
    row bark-off 🔕 "Turn off notifications"
    return
  fi
  [ -s "$JOBS/.bark.off" ] && row bark-on 🔔 "Turn notifications back on"
  row notice ℹ️ "Notifications come through Bark" "A free app: iSH-AOK can't send any itself"
  if [ -n "$SHORTCUT" ]; then
    row bark-store 1️⃣ "Get Bark" "Opens the App Store. Open Bark, allow its notifications"
  else
    row notice 1️⃣ "Get Bark from the App Store" "Open it and allow its notifications"
  fi
  row notice 2️⃣ "In Bark, copy a link" "Tap the copy button next to one of its links"
  row bark-paste 3️⃣ "Then tap here" "aria2 reads the link from the clipboard"
}

# A finished download opens in the Files app; any other shows its own screen. Fails after
# printing an answer for the Shortcut.
open_download() {  # open_download <id>
  load "$1"
  # The player plays videos and music right in the shortcut's Safari sheet.
  web_ok && { open_web "/play/$1" || return 1; return 0; }
  case $path in
    "$SHARE"/*)
      open_link "$(files_url "$path" || echo "shareddocuments://")"
      return 1 ;;
  esac
  not_in_files
}

show_folder() {  # show_folder <id>: its folder in the Files app
  load "$1"
  dir=$path
  [ -n "$playlist" ] || dir=${path%/*}
  case $dir in
    "$SHARE" | "$SHARE"/*)
      open_link "$(files_url "$dir" || echo "shareddocuments://")"
      return 1 ;;
  esac
  not_in_files
}

not_in_files() {
  notice "It's in iSH-AOK's own Downloads folder" "To get downloads in a Files folder, mount one in iSH-AOK: mount -t ios phone /mnt/phone"
  return 0
}

copy_text() {  # copy_text <text>: the answer that copies it, or else a notice showing it
  if [ "$LEVEL" -ge 3 ]; then
    notice "Copied the link" "$1"
    echo "@@copy:$1"
    return 1
  fi
  notice "Its link" "$1"
  return 0
}

# Download a finished download again, from the start and as a new download, for when its
# file was moved or deleted. If the file is still there, place (in deliver) keeps one copy.
again() {  # again <id>: prints what it did, as a title line and a detail line
  load "$1"
  title=${playlist:-$name}
  [ "$state" = running ] && pause "$1"
  fmt=$(cat "$JOBS/$1.fmt" 2>/dev/null)  # the quality picked for it, if one was
  forget "$1"
  last=$(ids | head -n 1)
  new=$((${last:-0} + 1))
  [ -z "$fmt" ] || printf '%s\n' "$fmt" >"$JOBS/$new.fmt"
  start "$link" "$new"
  echo "Downloading it again"
  echo "$title"
}

# Delete a finished download's file, wherever dl put it, then drop it from the list.
delete_download() {  # delete_download <id>: prints what it did, as a title line and a detail line
  load "$1"
  case $path in
    */../* | */..) echo "Couldn't delete $name"; return ;;
    "$SHARE"/?* | "$DEST"/?*) ;;
    *) echo "Couldn't find $name's file"; return ;;
  esac
  if [ ! -e "$path" ]; then
    forget "$1"
    echo "Removed $name from the list"
    echo "Its file was already gone"
  elif [ -f "$path" ] && timeout 60 rm -f "$path"; then
    forget "$1"
    echo "Deleted $name"
    echo "It's gone from Files"
  else
    echo "Couldn't delete $name"
    echo "Delete it in the Files app instead"
  fi
}

# ---- Debug reports: what to send whoever helps when something goes wrong ----

# report [<id>]: the phone's setup, the tools, the settings, the list, the whole log of the
# download (or of the latest failed one) and what the updates and the live view said. It
# leaves out the Bark key and the live view's token. Quick enough for a Run Command.
report() {
  rid=$1  # not id: status below uses that
  if [ -z "$rid" ]; then  # the latest failed download, else the latest one
    for i in $(ids); do
      load "$i"
      [ "$state" = failed ] && { rid=$i; break; }
    done
    [ -n "$rid" ] || rid=$(ids | head -n 1)
  fi
  echo "aria2 debug report · $(date)"
  echo "dl $(sha256sum <"$0" | cut -c1-8) · shortcut $(cat "$SHORTCUTS/.version" 2>/dev/null || echo '?')${SHORTCUT:+ (this one: $SHORTCUT)} · Alpine $(cat /etc/alpine-release 2>/dev/null || echo '?') · $(uname -m)"
  echo "yt-dlp $(cat "$JOBS/.yt-dlp-version" 2>/dev/null || echo '?') at $(command -v yt-dlp) · $(aria2c --version 2>/dev/null | head -n 1)"
  tools=
  for tool in ffmpeg node qjs python3 curl; do
    if command -v $tool >/dev/null; then tools="$tools $tool"; else tools="$tools (no $tool)"; fi
  done
  echo "Tools:$tools"
  echo "Free space: $(df -h "$DEST" 2>/dev/null | awk 'NR == 2 { print $4 }') · Files folder: $(share_ready && share_host || echo 'none mounted')"
  awake=no
  pgrep -f 'dd if=/dev/location' >/dev/null && awake=yes
  echo "Keeping iSH-AOK awake: $awake · /dev/location: $([ -e /dev/location ] && echo yes || echo no)"
  echo "Settings: notifications $(on_off "$JOBS/.bark") · automatic updates $(auto_updates && echo on || echo off) · pictures $(on_off_flag "$JOBS/.plain")"
  echo
  echo "== The list"
  status
  if [ -n "$rid" ] && [ -f "$JOBS/$rid.log" ]; then
    load "$rid"
    worker=no
    running "$rid" && worker=yes
    echo
    echo "== Download #$rid: $state${reason:+ ($reason)} · worker running: $worker"
    # Progress lines and aria2's summaries repeat every second or so: keep the last one.
    awk '/^\[#/ { last = $0; next }
      /^\*\*\* Download Progress Summary/ || /^-+$/ || /^ *$/ { next }
      $0 == previous { next }
      { if (last != "") { print last; last = "" } print; previous = $0 }
      END { if (last != "") print last }' "$JOBS/$rid.log" | tail -n 300
  fi
  for log in .update.log .app-update.log .web.log .choice/log; do
    [ -s "$JOBS/$log" ] || continue
    echo
    echo "== $log"
    tail -n 25 "$JOBS/$log"
  done
}

save_report() {  # save_report [<id>]: into .logs/report.txt, and into Files as aria2-debug.txt
  new_report "$1"
  report_to_files
}

new_report() {  # downloads that fail at once mustn't write into the same file
  report "$1" >"$JOBS/report.txt.$$" 2>&1
  mv -f "$JOBS/report.txt.$$" "$JOBS/report.txt"
}

report_to_files() {  # under another name first: writing into a file Files has open can hang
  share_ready || return 0
  timeout 30 cp "$JOBS/report.txt" "$SHARE/.aria2-debug.txt.new" &&
    timeout 30 mv -f "$SHARE/.aria2-debug.txt.new" "$SHARE/aria2-debug.txt"
}

report_row() {  # report_row <key> <what it covers>
  if [ "$LEVEL" -ge 3 ]; then
    row "$1" 🐞 "Copy a debug report" "$2, to paste for help"
  else
    row "$1" 🐞 "Save a debug report" "$2: aria2-debug.txt, in Downloads"
  fi
}

# report_answer [<id>]: a fresh report, copied (level 3) and saved in Files. Fails after an
# answer for the Shortcut.
report_answer() {
  new_report "$1"
  report_to_files >/dev/null 2>&1 </dev/null &  # Files may be slow; the copy isn't
  if [ "$LEVEL" -ge 3 ]; then
    notice "Copied a debug report" "Paste it into a message to whoever helps you"
    printf '@@copy:'
    cat "$JOBS/report.txt"
    return 1
  fi
  notice "Saved a debug report" "aria2-debug.txt, in your Downloads folder"
  return 0
}

# ---- The live view: web.py, a small web server, shown in the shortcut's Safari sheet ----

web_ok() {  # can this shortcut show it, and is it installed?
  [ "$LEVEL" -ge 2 ] && [ -f "$WEB" ] && command -v python3 >/dev/null
}

# web_link <path> [<download to scroll to>]: the live view's link, after starting its server
# if it isn't answering. Each start gets a new token, which every request has to carry.
web_link() {
  token=$(cat "$JOBS/.web-token" 2>/dev/null)
  if [ -z "$token" ] || ! curl -fs -m 2 -o /dev/null "http://127.0.0.1:$WEB_PORT/status?t=$token"; then
    pkill -f "$WEB $WEB_PORT" 2>/dev/null
    token=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
    echo "$token" >"$JOBS/.web-token"
    WEB_DEST=$DEST WEB_SHARE=$SHARE WEB_SHARE_HOST=$(share_host) WEB_DL=$0 \
      $(command -v setsid) nohup python3 "$WEB" "$WEB_PORT" "$token" >"$JOBS/.web.log" 2>&1 </dev/null &
    # Python takes a few seconds to start in iSH-AOK; the Shortcut gives up after 20.
    tries=0
    until curl -fs -m 2 -o /dev/null "http://127.0.0.1:$WEB_PORT/status?t=$token"; do
      tries=$((tries + 1))
      [ $tries -ge 24 ] && return 1
      sleep 0.5
    done
  fi
  echo "http://127.0.0.1:$WEB_PORT$1?t=$token${2:+#$2}"
}

open_web() {  # open_web <path> [<download>]: the answer that shows it. Fails once it's given.
  if ! url=$(web_link "$1" "$2"); then
    notice "The live view didn't start" "$(tail -n 1 "$JOBS/.web.log" 2>/dev/null)"
    return 0
  fi
  # Level 2 can't show a page in a sheet, so Safari opens it instead.
  if [ "$LEVEL" -ge 3 ]; then echo "@@web:$url"; else echo "@@open:$url"; fi
  return 1
}

web_act() {  # web_act <id> <pause|resume|stop|again>: the live view's buttons
  [ -f "$JOBS/$1.log" ] || { echo "That download is no longer in the list."; return; }
  load "$1"
  case $2 in
    pause) pause "$1"; rest_unless_busy; echo "Paused ${playlist:-$name}" ;;
    resume) start "$link" "$1"; echo "Resumed ${playlist:-$name}" ;;
    stop) out=$(stop "$1"); printf '%s\n' "$out" | head -n 1 ;;
    again) out=$(again "$1"); printf '%s\n' "$out" | tail -n 1 | sed 's/^/Downloading again: /' ;;
  esac
}

# shareddocuments://<iOS path> opens a file or folder in the Files app. iSH-AOK lists the
# iOS path of the folder mounted at $SHARE as that mount's source in /proc/mounts.
files_url() {  # files_url <path at or under $SHARE>
  case $1 in "$SHARE" | "$SHARE"/*) ;; *) return 1 ;; esac
  host=$(share_host)
  case $host in /*) ;; *) return 1 ;; esac
  printf 'shareddocuments://%s\n' "$(urlencode "$host${1#"$SHARE"}")"
}

share_host() {
  if [ -n "$DL_SHARE" ]; then  # tests: the folder stands for itself
    printf %s "$SHARE"
    return
  fi
  # Fields are separated by spaces, so a space in a path is written \040 (and \ as \134).
  sed -n "s|^\([^ ]*\) $SHARE [^ ]* .*|\1|p" /proc/mounts 2>/dev/null | head -n 1 |
    sed 's/\\040/ /g; s/\\134/\\/g'
}

urlencode() {  # percent-encode all but letters, digits, - . _ ~ and /
  printf %s "$1" | od -An -tx1 -v | awk '
    BEGIN {
      for (i = 32; i < 127; i++) {
        c = sprintf("%c", i)
        if (c ~ /[A-Za-z0-9._~\/-]/) keep[sprintf("%02x", i)] = c
      }
    }
    { for (i = 1; i <= NF; i++) out = out (($i in keep) ? keep[$i] : "%" toupper($i)) }
    END { printf "%s", out }'
}

# Keep the list short: only the newest $KEEP_FINISHED finished downloads stay on it.
prune() {
  kept=0
  for id in $(ids); do
    load "$id"
    case $state in
      done | failed)
        kept=$((kept + 1))
        [ $kept -gt $KEEP_FINISHED ] && forget "$id" ;;
    esac
  done
}

forget() {  # forget <id>: drop it from the list
  rm -f "$JOBS/$1.log" "$JOBS/$1.pid" "$JOBS/$1.thumb" "$JOBS/$1.fmt" "$JOBS/$1.info.json"
}

# Stop a download for good: delete what it left unfinished. A playlist that finished some
# videos keeps them, moved to Files like any download, and stays on the list as stopped;
# anything else leaves the list. Prints what it did: a title line and a detail line.
stop() {  # stop <id>
  load "$1"
  title=${playlist:-$name}
  [ "$state" = running ] && pause "$1"
  rest_unless_busy
  if [ "$via" = yt-dlp ]; then
    # yt-dlp names each file it starts ("[download] Destination: …"), and says FILE: for
    # each one it finished.
    finished=$(segment "$1" | sed -n 's/^FILE: //p')
    segment "$1" | sed -n 's/^\[download\] Destination: //p' | while IFS= read -r p; do
      printf '%s\n' "$finished" | grep -qxF -- "$p" || unfinished "$p"
    done
    deliver "$1" >>"$JOBS/$1.log"
  else
    # aria2 names its file (a torrent's first file) in FILE: lines while it downloads.
    segment "$1" | sed -n 's/^FILE: //p' | sort -u | while IFS= read -r p; do
      unfinished "$p"
      top=${p#"$DEST"/}
      top=${top%%/*}
      # A torrent downloads into a folder of its own, with its .aria2 file next to it.
      if [ -n "$top" ] && [ "$top" != "${p#"$DEST"/}" ] && [ -d "$DEST/$top" ]; then
        rm -rf "${DEST:?}/${top:?}"
        rm -f "${DEST:?}/${top:?}.aria2"
      fi
    done
  fi
  load "$1"
  echo "Stopped $title"
  if [ -n "$playlist" ] && [ "$videos" -gt 0 ]; then
    echo "=== stopped" >>"$JOBS/$1.log"
    echo "Kept the $videos video(s) it had finished"
  else
    forget "$1"
    echo "Deleted what it had downloaded"
  fi
}

unfinished() {  # unfinished <path>: delete a partial download, only ever inside $DEST
  case $1 in "$DEST"/?*) ;; *) return 0 ;; esac
  rm -f "$1" "$1.part" "$1.ytdl" "$1.aria2" "$1".part-Frag*
}

case $1 in
  -ui) [ "$4" = -k ] && SHORTCUT=$5; ui "$(decode "$3")" ;;
  --shortcut) base64 "$SHORTCUTS/aria2.shortcut" | tr -d '\n' ;;  # for @@import
  --work) work "$2" ;;
  --thumb) thumb "$2" "$3" ;;
  --act) web_act "$2" "$3" ;;      # the live view's buttons (web.py)
  --awake) keep_awake ;;           # while the live view is open
  --rest) rest_unless_busy ;;      # when it closes
  --report) report "$2" ;;         # a debug report (see report)
  --probe) probe ;;                # the qualities of a video (see choose)
  --update)
    keep_awake
    case $2 in tools | app) update_now "$2" ;; *) update_now tools; update_now app ;; esac
    rest_unless_busy ;;
  -u) update_in_background both; echo "Updating aria2 and its tools in the background." ;;
  -v) versions ;;
  -s) status ;;
  -m) status; actions ;;
  -a) act "$(decode "$3")" ;;
  -b) add_links "$(decode "$2")" ;;
  -p | -x) pause_all ;;
  -r) resume_all ;;
  -c) clear_finished ;;
  '' | -h | --help) sed -n '2,17p' "$0" ;;
  *) add_links "$*" ;;
esac
